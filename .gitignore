.env
*.env
!*.env.example

__pycache__/
*.pyc
.pytest_cache/
*.log
.venv/

# Runtime state, not source -- these get written by running the harness,
# never commit them
quota_pacer_state.json
backtest_state.json
cycle_checkpoint.json

# ask_hermes's failure-only diagnostic seam (correction pass): bounded,
# redacted local records of a response that exhausted the two-attempt
# retry path -- diagnosis aid only, never Neon/dashboard/committed source.
backtest-harness/.diagnostics/

# Experimental Laya selector (Phase 2): private per-run selection snapshots and
# the local Laya worker log -- runtime artifacts, never committed.
backtest-harness/.selector_snapshots/
# Standalone Laya demo (laya_demo.py): write-once artifacts, the PRIVATE
# row-ID -> ticker mappings, and worker logs -- runtime output, never committed.
backtest-harness/.laya_demo/

# Scalable screener (Stage 1): local write-once screen snapshots -- runtime
# data, never committed.
watchlist/.screen_snapshots/

# Machine-readable raw output of the human-only offline diagnostics
# (geometry_scan.py / counterfactual.py / benchmark_sensitivity.py) --
# regenerate by re-running the script, never the source of truth itself
.geometry_scan_data.json
.counterfactual_data.json
.benchmark_sensitivity_data.json

# Auto-installed third-party skill plugin (Leonxlnx/taste-skill), unrelated
# to this project -- not our source, don't want it in this repo's history
.agents/
.claude/
skills-lock.json

# Old diagram source, already published separately as a Claude Artifact --
# scratch work, not project source
scratchpad/

# Local Obsidian vault state, created when the repository root is opened
# as a vault -- machine-specific, not project source
/.obsidian/

# fundamentals/'s SQLite response cache -- a runtime data cache of raw
# SEC JSON, regenerated on demand from the SEC's own public endpoints,
# never the source of truth itself
fundamentals/.cache/

# wrangler's local cache/account-id scratch (created by `npx wrangler
# pages deploy` -- see dashboard-v2/README.md's Deployment section);
# never source, never the auth token itself (that lives outside the
# repo), but no reason to track it either
.wrangler/

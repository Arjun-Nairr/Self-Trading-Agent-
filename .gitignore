.env
*.env
!*.env.example

__pycache__/
*.pyc
.pytest_cache/
*.log
.venv/

# Runtime state, not source -- these get written by running the harness,
# never commit them
quota_pacer_state.json
backtest_state.json
cycle_checkpoint.json

# Machine-readable raw output of the human-only offline diagnostics
# (geometry_scan.py / counterfactual.py / benchmark_sensitivity.py) --
# regenerate by re-running the script, never the source of truth itself
.geometry_scan_data.json
.counterfactual_data.json
.benchmark_sensitivity_data.json

# Auto-installed third-party skill plugin (Leonxlnx/taste-skill), unrelated
# to this project -- not our source, don't want it in this repo's history
.agents/
.claude/
skills-lock.json

# Old diagram source, already published separately as a Claude Artifact --
# scratch work, not project source
scratchpad/

# Local Obsidian vault state, created when the repository root is opened
# as a vault -- machine-specific, not project source
/.obsidian/

# fundamentals/'s SQLite response cache -- a runtime data cache of raw
# SEC JSON, regenerated on demand from the SEC's own public endpoints,
# never the source of truth itself
fundamentals/.cache/
